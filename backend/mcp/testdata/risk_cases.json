[
  { "cmd": "", "want": "dangerous", "note": "missing command is never assumed harmless" },
  { "cmd": "   ", "want": "dangerous" },
  { "cmd": "FOO=1", "want": "read", "note": "lone assignment runs no command" },

  { "cmd": "rm -rf /tmp/x", "want": "dangerous" },
  { "cmd": "sudo -n rm -rf /tmp/x", "want": "dangerous" },
  { "cmd": "sh -c 'rm -rf /tmp/x'", "want": "dangerous" },
  { "cmd": "nice -n 5 rm -rf /tmp/x", "want": "dangerous", "note": "F-02: was write (nice options fell through)" },
  { "cmd": "time -p rm -rf /tmp/x", "want": "dangerous", "note": "F-02: was write" },
  { "cmd": "env -S 'rm -rf /tmp/x'", "want": "dangerous", "note": "F-02: was write" },
  { "cmd": "python3 -c 'import shutil;shutil.rmtree(\"/tmp/x\")'", "want": "dangerous", "note": "F-02: interpreter payload is unjudgeable" },
  { "cmd": "node -e 'require(\"fs\").rmSync(\"/tmp/x\",{recursive:true})'", "want": "dangerous" },
  { "cmd": "perl -e 'system(\"rm -rf /tmp/x\")'", "want": "dangerous" },
  { "cmd": "ruby -e 'puts 1'", "want": "dangerous", "note": "F-02: any interpreter -e payload grades dangerous" },
  { "cmd": "bash -c \"echo pwned\"", "want": "dangerous" },
  { "cmd": "eval rm -rf /tmp/x", "want": "dangerous" },
  { "cmd": "xargs rm", "want": "dangerous" },
  { "cmd": "cat file | xargs rm", "want": "dangerous" },
  { "cmd": "/usr/bin/sudo rm -rf /", "want": "dangerous", "note": "F-02: wrapper detection is path-insensitive" },
  { "cmd": "nohup rm -rf /tmp/x", "want": "dangerous" },
  { "cmd": "command rm -rf /", "want": "dangerous" },
  { "cmd": "C:\\Windows\\System32\\rm.exe -rf /", "want": "dangerous" },

  { "cmd": "sort -o /tmp/out /etc/hosts", "want": "write", "note": "F-02: read head with a write option" },
  { "cmd": "git log --output=/tmp/out", "want": "write", "note": "F-02" },
  { "cmd": "find /tmp -fprint /tmp/out", "want": "write", "note": "F-02" },
  { "cmd": "find . -ok rm {} +", "want": "write", "note": "F-02: -ok runs a command" },
  { "cmd": "date -s 20200101", "want": "write", "note": "F-02" },
  { "cmd": "hostname myhost", "want": "write", "note": "F-02: positional arg sets the hostname" },
  { "cmd": "man rm", "want": "write", "note": "F-02: interactive pager removed from read heads" },
  { "cmd": "less /etc/passwd", "want": "write", "note": "F-02" },
  { "cmd": "top", "want": "write", "note": "F-02" },

  { "cmd": "ls -la", "want": "read" },
  { "cmd": "git status", "want": "read" },
  { "cmd": "git log --oneline", "want": "read", "note": "known-safe option stays read" },
  { "cmd": "cat /etc/hostname", "want": "read" },
  { "cmd": "cat ~/.ssh/id_rsa", "want": "read", "note": "reads stay silent; the write side of an exfil is what must prompt" },
  { "cmd": "grep -rn TODO .", "want": "read" },
  { "cmd": "sort -k 2 file.txt", "want": "read", "note": "known-safe option stays read" },
  { "cmd": "date +%Y-%m-%d", "want": "read" },
  { "cmd": "find . -name '*.txt'", "want": "read" },
  { "cmd": "hostname", "want": "read" },
  { "cmd": "hostname -I", "want": "read" },
  { "cmd": "jq '.a' file.json", "want": "read" },
  { "cmd": "env", "want": "read", "note": "bare wrapper runs nothing" },
  { "cmd": "env FOO=1 ls", "want": "read" },
  { "cmd": "env -u FOO ls", "want": "read" },
  { "cmd": "sudo ls", "want": "read" },
  { "cmd": "cd /tmp && ls", "want": "read" },
  { "cmd": "ls > /dev/null", "want": "read" },
  { "cmd": "cat f 2>&1", "want": "read" },

  { "cmd": "touch file", "want": "write" },
  { "cmd": "git pull origin main", "want": "write" },
  { "cmd": "some-unknown-tool --flag", "want": "write" },
  { "cmd": "ls && touch f", "want": "write" },
  { "cmd": "echo hi > /tmp/out", "want": "write" },
  { "cmd": "python3 -c", "want": "write", "note": "flag without a payload: not a hidden execution body" },
  { "cmd": "echo k >> ~/.ssh/authorized_keys 2>/dev/null", "want": "write" },
  { "cmd": "echo hi > /etc/passwd", "want": "dangerous" },
  { "cmd": ":(){ :|:& };:", "want": "dangerous", "note": "fork bomb" }
]
