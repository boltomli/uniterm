# Filename is org.wails.uniterm.desktop on purpose: Wails builds the
# GtkApplication with id "org.wails." + lowercase Options.Name, and GNOME on
# Wayland matches running windows to launchers by desktop-file filename ==
# app_id. StartupWMClass below only serves X11 (WM_CLASS instance from
# LinuxOptions.ProgramName). Renaming this file breaks the dash icon for
# every Wayland user.
[Desktop Entry]
Name=uniTerm
Comment=Lightweight All-in-One Terminal Emulator
Exec=/usr/bin/uniterm
Icon=uniterm
Terminal=false
Type=Application
Categories=System;TerminalEmulator;
StartupWMClass=uniterm