# npm 12 defaults allow-remote=none, which refuses dependencies pinned to a
# raw tarball URL (EALLOWREMOTE). Keep this if any dependency is pinned to an
# http(s) URL in package.json (all current ones are vendored under vendor/
# and use file: specs instead, which is preferred — GitHub release assets are
# unreliable on some networks).
# "root" = allow only URL deps declared in this project's package.json —
# transitive URL deps stay blocked, unlike "all".
allow-remote=root
